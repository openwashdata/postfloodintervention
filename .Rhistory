# Load necessary libraries
library(ggplot2)
library(dplyr)
# Summarize counts of pump operational status, excluding missing values
pump_status_counts <- postfloodintervention %>%
filter(!is.na(operational_feel_of_pump)) %>%  # Remove NA values
count(operational_feel_of_pump) %>%           # Count number of occurrences per status
arrange(desc(n))                              # Optional: sort descending by count
# Bar chart of pump operational status
ggplot(pump_status_counts, aes(x = operational_feel_of_pump, y = n, fill = operational_feel_of_pump)) +
geom_bar(stat = "identity") +                 # Use identity stat because y is already counts
labs(
title = "Distribution of Pump Operational Status",
x = "Pump Operational Status",
y = "Number of Water Points"
) +
theme_minimal() +                             # Clean minimal theme
theme(legend.position = "none",               # Remove legend (fill labels shown on x-axis)
axis.text.x = element_text(angle = 45, hjust = 1))  # Rotate x labels for readability
# Pie chart of pump operational status proportions
ggplot(pump_status_counts, aes(x = "", y = n, fill = operational_feel_of_pump)) +
geom_col(width = 1) +                         # Bar chart with width=1 for pie shape
coord_polar(theta = "y") +                    # Convert to polar coordinates (pie chart)
labs(
title = "Pump Operational Status Proportions"
) +
theme_void() +                                # Remove all axes and background
theme(legend.title = element_blank())        # Remove legend title
# Bar chart of pump operational status
ggplot(pump_status_counts, aes(x = operational_feel_of_pump, y = n, fill = operational_feel_of_pump)) +
geom_bar(stat = "identity") +                 # Use identity stat because y is already counts
labs(
title = "Distribution of Pump Operational Status",
x = "Pump Operational Status",
y = "Number of Water Points"
) +
